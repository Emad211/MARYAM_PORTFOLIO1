# ---- Supabase ----
# Project URL and API keys from your Supabase project settings:
# https://supabase.com/dashboard/project/_/settings/api

# Public — safe to expose to the browser (sent to the client).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Secret — SERVER ONLY. Never prefix with NEXT_PUBLIC_ and never expose to the client.
# Bypasses Row Level Security; treat as a full-access credential.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# ---- Seeding only (not used by the running app) ----
# Initial admin credentials for `node scripts/seed.mjs`, which provisions the
# Supabase Auth admin user (app_metadata.role = 'admin'). After seeding, change
# them from /admin/settings/account; they are not read at runtime.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Supabase Management API personal access token (sbp_...), used only by
# `scripts/apply-schema.mjs` to apply the migration over HTTPS. Pass it inline
# for a one-off run; do NOT commit it. Not read by the app.
# SUPABASE_ACCESS_TOKEN=sbp_xxxxxxxxxxxxxxxxxxxx
